%% Convertido de: 02 - C4 - Container.puml
%% Setas mantêm o sentido original; a dica de layout (Rel_U/Rel_D/Rel_R) foi omitida.
flowchart TB
    bank["Agentes Financeiros<br/>Cliente externo que irá customizar os roteiros contábeis ou consultar um determinado evento contábel"]
    transactions["Sistema de Transações Financeiras<br/>Serviço responsável por gerenciar as transações financeiras"]
    migrations["Sistema de Migração de Contas<br/>Serviço que gerencia a migração das contas externas para o contexto da empresa"]
    datalake["Sistema de Relatórios<br/>Sistema que gerencia os relatórios financeiros e contábeis"]

    subgraph financial_accounting["Sistema de Contabilidade"]
        scripts["Serviço de Roteiros Contábeis<br/>Gerencia os roteiros contábeis customizados pelo cliente"]

        subgraph events["Serviço de Eventos Contábeis"]
            accounting_events["Serviço Gerenciamento de Eventos Contábeis<br/>Golang<br/>Gerencia os lançamentos contábeis processados pela plataforma"]
            accounting_transactions_worker["Processador de Eventos Financeiros<br/>Golang<br/>Processa os eventos financeiros gerados pela plataforma"]
            accounting_migrations_worker["Processador de Eventos de Migração<br/>Golang<br/>Processa os eventos financeiros de migração gerados pela plataforma"]
            sqs_transactions["Fila de Mensagens (SQS)<br/>Consome os eventos de transação financeira produzidos pela plataforma"]
            sqs_migragions["Fila de Mensagens (SQS)<br/>Consome os eventos de transação financeira de migração produzidos pela plataforma"]
            mySQL["Banco de dados (MySQL)<br/>Armazena os dados dos Eventos contábeis"]
            sns_events["Servidor de Mensagens (SNS)<br/>Notifica outros serviços sobre criação dos eventos contábeis"]

            accounting_transactions_worker -->|"Consome os eventos de transação financeira (JSON)"| sqs_transactions
            accounting_migrations_worker -->|"Consome os eventos de transação financeira de migração (JSON)"| sqs_migragions
            accounting_events -->|"Persiste os eventos contábeis (SQL)"| mySQL
            accounting_events -->|"Publica os eventos contábeis (JSON)"| sns_events
            accounting_transactions_worker -->|"Lança um evento contábil (JSON)"| accounting_events
            accounting_migrations_worker -->|"Lança um evento contábil (JSON)"| accounting_events
        end

        accounting_events -->|"Recupera um roteiro contábil para processar o evento (JSON)"| scripts
    end

    bank -->|"Customiza um roteiro contábel (JSON)"| scripts
    bank -->|"Consulta os lançamentos contábeis, ou efetuar um lançamento contábil avulso (JSON)"| accounting_events
    bank -->|"Lança um evento contábil avulso (JSON)"| accounting_events
    datalake -.->|"Consome os eventos processados para gerar relatórios contábeis (DMS/SQL, async)"| mySQL
    sqs_transactions -->|"Subscribe tópico para processar eventos financeiros"| transactions
    sqs_migragions -->|"Subscribe tópico para processar eventos financeiros de migração"| migrations
